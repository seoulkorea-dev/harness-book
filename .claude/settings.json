{
  "permissions": {
    "allow": ["Bash(python tools/build.py)", "Bash(python lint/*)", "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(gh pr view:*)"],
    "deny": ["Bash(git push --force:*)", "Bash(git push origin main:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python tools/hook_lint.py", "timeout": 120 }]
      }
    ]
  }
}
